rules_version = '2';

// ===============================================================
// KALAJAY HANDCRAFTED LUXURIES — PRODUCTION FIRESTORE SECURITY RULES
// Database: kalajay-667ff (asia-south1)
// Architecture: Least-Privilege Role-Based Access Control (RBAC)
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // Core Helper Functions
    // -------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Secure Administrator Determination:
    // 1. Firebase Auth Custom Claim (token.admin == true) set by privileged backend Admin operations
    // 2. Verified Server-Managed Document in /admin_users/{uid} (whitelist ACL)
    // 3. Root Super Administrator Immutable UID (Soumya - Founder & Head of Maison)
    // NOTE: Email whitelists and domain matching are strictly removed to prevent spoofing or domain self-registration vectors.
    function isRootAdmin() {
      return isAuthenticated() && request.auth.uid == 'mJ6lPWSeACcLSCSKqonwcksD87I2';
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) ||
        isRootAdmin()
      );
    }

    // -------------------------------------------------------------
    // Validation Helpers
    // -------------------------------------------------------------
    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.code is string && data.code.size() > 0 && data.code.size() <= 50 &&
             data.price is number && data.price >= 0 &&
             data.category is string &&
             data.coverImage is string;
    }

    function isValidUser(data, userId) {
      return data.id == userId &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 25)) &&
             // Privilege escalation & business data integrity guards (Concern 3)
             (
               isAdmin() || (
                 (!('role' in data) || data.role == 'customer' || (resource != null && data.role == resource.data.role)) &&
                 (!('isAdmin' in data) || data.isAdmin == false || (resource != null && data.isAdmin == resource.data.isAdmin)) &&
                 (!('staffId' in data) || (resource != null && data.staffId == resource.data.staffId)) &&
                 (!('requiresPasswordReset' in data) || (resource != null && data.requiresPasswordReset == resource.data.requiresPasswordReset)) &&
                 // Reward Points & Loyalty Tier Protection (Concern 3):
                 // On creation: welcome points capped at 300, tier must be default Kalajay Circle / Silver
                 // On update: non-admins cannot inflate reward points or alter loyalty tier
                 (
                   (resource == null && (!('rewardPoints' in data) || data.rewardPoints <= 300) && (!('tier' in data) || data.tier in ['Kalajay Circle', 'Silver'])) ||
                   (resource != null && (!('rewardPoints' in data) || data.rewardPoints <= resource.data.rewardPoints) && (!('tier' in data) || data.tier == resource.data.tier))
                 )
               )
             );
    }

    function isValidOrder(data) {
      return data.id is string && data.id.size() > 0 &&
             data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 120 &&
             data.total is number && data.total >= 0 &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 50 &&
             data.shippingAddress is map &&
             data.fulfillmentStatus in ['unfulfilled', 'in_loom', 'quality_checked', 'shipped', 'delivered', 'rto'] &&
             // Payment Status & Fulfillment Guards (Concern 3 & 4):
             // Direct client submissions cannot self-grant 'paid' status or trigger fulfillment
             (
               isAdmin() || (
                 data.paymentStatus == 'pending' &&
                 data.fulfillmentStatus == 'unfulfilled'
               )
             );
    }

    function isValidCustomEnquiry(data) {
      return data.silhouette is string && data.silhouette.size() > 0 &&
             data.estimatedPrice is number && data.estimatedPrice >= 0 &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000));
    }

    function isValidSupportTicket(data) {
      return data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 120 &&
             data.email is string && data.email.size() > 0 &&
             data.subject is string && data.subject.size() > 0 && data.subject.size() <= 200 &&
             data.messages is list && data.messages.size() > 0;
    }

    // -------------------------------------------------------------
    // 1. Products Catalogue
    // Storefront visitors need public read access to browse the catalogue.
    // Writes are strictly restricted to verified Administrators.
    // -------------------------------------------------------------
    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidProduct(request.resource.data);
      allow update: if isAdmin() && isValidProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 2. Collections & Categories
    // Public read for navigation. Admin write only.
    // -------------------------------------------------------------
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------
    // 3. CMS & Homepage Rails (Featured Curation, Banners)
    // Public read for website presentation. Admin write only.
    // -------------------------------------------------------------
    match /cms/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------
    // 4. Inventory ERP & Stock
    // Read: Public (to display stock status on product pages).
    // Write: Strictly restricted to verified Administrators.
    // -------------------------------------------------------------
    match /inventory/{sku} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Stock adjustments audit trail - Admin only
    match /stock_adjustments/{adjId} {
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------
    // 5. Coupons & Promotions
    // Public can read active coupons to validate promo codes at checkout.
    // Create/update/delete restricted to Administrators.
    // -------------------------------------------------------------
    match /coupons/{couponId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------
    // 6. Patron User Profiles (/users/{userId})
    // Strictly private: A user may only read/write their own profile.
    // -------------------------------------------------------------
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) && isValidUser(request.resource.data, userId)) || isAdmin();
      allow update: if (isOwner(userId) && isValidUser(request.resource.data, userId)) || isAdmin();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 7. Orders (/orders/{orderId})
    // Creation: Permitted for legitimate checkout submissions.
    // Read: Restricted to the patron who placed the order OR Admin.
    // Update: STRICTLY ADMIN ONLY. Patrons CANNOT modify orders, prices,
    // payment status, or tracking stages once placed.
    // Delete: Disallowed (audit trail protection).
    // -------------------------------------------------------------
    match /orders/{orderId} {
      allow create: if isValidOrder(request.resource.data) && (
        !isAuthenticated() ||
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.customerEmail == request.auth.token.email ||
        isAdmin()
      );
      allow read: if (
        isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          (request.auth.token.email != null && resource.data.customerEmail == request.auth.token.email)
        )
      ) || isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // -------------------------------------------------------------
    // 8. Bespoke Custom Enquiries (/custom_enquiries)
    // Patrons & guests can submit custom commission requests.
    // Read/Update/Delete is strictly restricted to Admin/Concierge.
    // -------------------------------------------------------------
    match /custom_enquiries/{enquiryId} {
      allow create: if isValidCustomEnquiry(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 9. Corporate Gifting Enquiries (/corporate_enquiries)
    // Prospective institutional clients can submit leads.
    // Read/Update/Delete is strictly restricted to Admin.
    // -------------------------------------------------------------
    match /corporate_enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 10. Support Tickets (/support_tickets)
    // Create: Anyone can create a support ticket.
    // Read: Ticket creator (by email/userId match) OR Admin.
    // Update: Admin can reply/resolve; Creator can append messages only.
    // Delete: Disallowed.
    // -------------------------------------------------------------
    match /support_tickets/{ticketId} {
      allow create: if isValidSupportTicket(request.resource.data);
      allow read: if (
        isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          (request.auth.token.email != null && resource.data.email == request.auth.token.email)
        )
      ) || isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        (resource.data.userId == request.auth.uid || resource.data.email == request.auth.token.email) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['messages', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 11. Security Audit Logs (/audit_logs)
    // Read restricted to Administrators; writes strictly restricted to Root Super Admin.
    // -------------------------------------------------------------
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isRootAdmin();
    }

    // -------------------------------------------------------------
    // 12. Admin Users ACL (/admin_users/{adminId})
    // Read: Verified Administrators only (customers cannot enumerate staff).
    // Write: Strictly restricted to Root Super Admin (prevents staff privilege escalation).
    // -------------------------------------------------------------
    match /admin_users/{adminId} {
      allow read: if isAdmin();
      allow write: if isRootAdmin();
    }

    // -------------------------------------------------------------
    // 13. System Health Diagnostics (/system/{docId})
    // Restrict public read to operational health beacon only.
    // -------------------------------------------------------------
    match /system/{docId} {
      allow read: if docId == 'health';
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------
    // 14. Checkout Idempotency Register (/idempotency_keys/{key})
    // Server checkout pipeline writes and verifies unique request hashes.
    // -------------------------------------------------------------
    match /idempotency_keys/{key} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------
    // 15. Dynamic Administrative Roles (/admin_roles/{roleId})
    // Read: Verified Administrators only.
    // Write: Strictly restricted to Root Super Admin (ordinary staff cannot alter roles).
    // -------------------------------------------------------------
    match /admin_roles/{roleId} {
      allow read: if isAdmin();
      allow write: if isRootAdmin();
    }

    // -------------------------------------------------------------
    // 16. Staff ID Login Index (/staff_id_index/{staffId})
    // Read: Authenticated staff / server lookup.
    // Write: Verified Administrators only.
    // -------------------------------------------------------------
    match /staff_id_index/{staffId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------
    // 17. System Counters (/counters/{counterId})
    // Write: Verified Administrators only.
    // -------------------------------------------------------------
    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------
    // 18. Staff Usernames Directory (/admin_usernames/{username})
    // Strictly restricted against all direct client reads and writes.
    // Username resolution and availability checks operate exclusively via secure backend API endpoints.
    // -------------------------------------------------------------
    match /admin_usernames/{username} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // 19. Distributed Tracking Rate Limiter (/tracking_ratelimits/{ipHash})
    // Shared across server instances for distributed DDoS and order enumeration defense.
    // -------------------------------------------------------------
    match /tracking_ratelimits/{ipHash} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------
    // Default Deny
    // -------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

// ===============================================================
// Kalajay Handcrafted Luxuries - Cloud Firestore Security Rules
// Project ID: kalajay-667ff
// Architecture: Next.js Digital Flagship + Unified Admin Operations
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Products Catalogue
    // Storefront shoppers require public read access.
    // Operations console manages product records, pricing, and imagery.
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // 2. Collections & Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // 3. Orders & Tracking
    // Shoppers can create orders at checkout and look up order tracking.
    // Admin operations console manages status transitions (In Loom -> Shipped -> Delivered).
    match /orders/{orderId} {
      allow read: if true;
      allow write: if true;
    }

    // 4. Patron Users & Profiles
    // Synchronized with Firebase Authentication UID.
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // 5. Bespoke Studio Custom Enquiries
    // Website patrons submit custom colorway, silhouette, and monogram requests.
    // Concierge and studio staff inspect and quote via Admin console.
    match /custom_enquiries/{enquiryId} {
      allow read: if true;
      allow write: if true;
    }

    // 6. Corporate & Bulk Gifting Requests
    match /corporate_enquiries/{enquiryId} {
      allow read: if true;
      allow write: if true;
    }

    // 7. Patron Concierge & Support Tickets
    match /support_tickets/{ticketId} {
      allow read: if true;
      allow write: if true;
    }

    // 8. CMS, Homepage Banners & Featured Products Curation
    match /cms/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // 9. Inventory ERP & Stock Adjustments
    match /inventory/{sku} {
      allow read: if true;
      allow write: if true;
    }
    match /stock_adjustments/{adjId} {
      allow read: if true;
      allow write: if true;
    }

    // 10. Marketing Coupons & Promotional Vouchers
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if true;
    }

    // 11. Security Audit Logs
    match /audit_logs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    // 12. System Health & Connectivity Diagnostics
    match /system/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}

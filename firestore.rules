rules_version = '2';

// ===============================================================
// KALAJAY HANDCRAFTED LUXURIES — PRODUCTION FIRESTORE SECURITY RULES
// Database: kalajay-667ff (asia-south1)
// Architecture: Least-Privilege Role-Based Access Control (RBAC)
// Security Tier: Zero-Trust Hardened (Production Release)
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // Core Authentication & Identity Helpers
    // -------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Root Super Administrator: Immutable UID (Soumya - Founder & Head of Maison)
    // NOTE: Hardcoded root UID prevents all email spoofing or domain self-registration vectors.
    function isRootAdmin() {
      return isAuthenticated() && request.auth.uid == 'mJ6lPWSeACcLSCSKqonwcksD87I2';
    }

    // Secure Administrator Determination:
    // 1. Firebase Auth Custom Claim (token.admin == true) set by privileged backend Admin operations
    // 2. Verified Server-Managed Document in /admin_users/{uid} (whitelist ACL)
    // 3. Root Super Administrator Immutable UID
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) ||
        isRootAdmin()
      );
    }

    // Helper to retrieve verified administrative user document
    function getAdminData() {
      return get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data;
    }

    // Verify staff account is active and not deactivated
    function isStaffActive() {
      return isAuthenticated() && (
        isRootAdmin() ||
        (exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
         (!('active' in getAdminData()) || getAdminData().active == true) &&
         (!('status' in getAdminData()) || getAdminData().status == 'active'))
      );
    }

    // Granular Role-Based Access Control (RBAC) Helpers:
    // Check specific role or roleId assignment
    function hasRole(roleName) {
      return isAuthenticated() && (
        isRootAdmin() ||
        (exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
         isStaffActive() &&
         (getAdminData().role == roleName || getAdminData().roleId == roleName))
      );
    }

    // Store Managers & Super Admins (Catalogue, CMS, Coupons, Storefront)
    function isStoreManagerOrSuperAdmin() {
      return isRootAdmin() ||
             hasRole('super_admin') ||
             hasRole('role-super-admin') ||
             hasRole('store_manager') ||
             hasRole('role-store-manager');
    }

    // Inventory & Atelier Operations Staff (Inventory ERP, Stock Adjustments)
    function isInventoryStaffOrAdmin() {
      return isStoreManagerOrSuperAdmin() ||
             hasRole('inventory_manager') ||
             hasRole('role-inventory-manager') ||
             hasRole('production_head') ||
             hasRole('role-production-head');
    }

    // -------------------------------------------------------------
    // Data Validation Helpers
    // -------------------------------------------------------------
    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.code is string && data.code.size() > 0 && data.code.size() <= 50 &&
             data.price is number && data.price >= 0 &&
             data.category is string &&
             data.coverImage is string;
    }

    function isValidUser(data, userId) {
      return data.id == userId &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 25)) &&
             // Privilege escalation & business data integrity guards (Concern 3 & Requirement 5)
             (
               isAdmin() || (
                 (!('role' in data) || data.role == 'customer') &&
                 (!('isAdmin' in data) || data.isAdmin == false) &&
                 (!('staffId' in data)) &&
                 (!('requiresPasswordReset' in data)) &&
                 // Reward Points & Loyalty Tier Protection (Requirement 5):
                 // On creation: inaugural points capped at 300, tier must be default Kalajay Circle / Silver
                 // On update: non-admins CANNOT inflate reward points or alter loyalty tier
                 (
                   (resource == null && (!('rewardPoints' in data) || data.rewardPoints <= 300) && (!('tier' in data) || data.tier in ['Kalajay Circle', 'Silver'])) ||
                   (resource != null && (!('rewardPoints' in data) || data.rewardPoints == resource.data.rewardPoints) && (!('tier' in data) || data.tier == resource.data.tier))
                 )
               )
             );
    }

    function isValidCustomEnquiry(data) {
      return data.silhouette is string && data.silhouette.size() > 0 &&
             data.estimatedPrice is number && data.estimatedPrice >= 0 &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000));
    }

    function isValidSupportTicket(data) {
      return data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 120 &&
             data.email is string && data.email.size() > 0 &&
             data.subject is string && data.subject.size() > 0 && data.subject.size() <= 200 &&
             data.messages is list && data.messages.size() > 0 && data.messages.size() <= 50;
    }

    // -------------------------------------------------------------
    // 1. Products Catalogue (/products/{productId})
    // Storefront visitors have public read access to browse the catalogue.
    // Writes are restricted to Store Managers and Super Admins.
    // Restricted staff (e.g., inventory clerks) CANNOT modify product listings.
    // -------------------------------------------------------------
    match /products/{productId} {
      allow read: if true;
      allow create: if isStoreManagerOrSuperAdmin() && isValidProduct(request.resource.data);
      allow update: if isStoreManagerOrSuperAdmin() && isValidProduct(request.resource.data);
      allow delete: if isStoreManagerOrSuperAdmin();
    }

    // -------------------------------------------------------------
    // 2. Collections & Categories (/categories/{categoryId})
    // Public read for website navigation. Write restricted to Store Managers & Super Admins.
    // -------------------------------------------------------------
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isStoreManagerOrSuperAdmin();
    }

    // -------------------------------------------------------------
    // 3. CMS & Homepage Rails (/cms/{docId})
    // Public read for featured creations and banners.
    // Write restricted to Store Managers & Super Admins.
    // -------------------------------------------------------------
    match /cms/{docId} {
      allow read: if true;
      allow write: if isStoreManagerOrSuperAdmin();
    }

    // -------------------------------------------------------------
    // 4. Inventory ERP & Stock (/inventory/{sku})
    // Read: Public (to display stock status on product pages).
    // Write: Restricted to Inventory Managers, Store Managers, Production Heads, and Super Admins.
    // -------------------------------------------------------------
    match /inventory/{sku} {
      allow read: if true;
      allow write: if isInventoryStaffOrAdmin();
    }

    // Stock adjustments audit trail - Verified inventory & admin staff only
    match /stock_adjustments/{adjId} {
      allow read: if isAdmin();
      allow write: if isInventoryStaffOrAdmin();
    }

    // -------------------------------------------------------------
    // 5. Coupons & Promotions (/coupons/{couponId})
    // Public can read active coupons to validate promo codes at checkout.
    // Create/update/delete restricted to Store Managers & Super Admins.
    // -------------------------------------------------------------
    match /coupons/{couponId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isStoreManagerOrSuperAdmin();
    }

    // -------------------------------------------------------------
    // 6. Patron User Profiles (/users/{userId})
    // Private: A user may only read/write their own profile.
    // Privilege escalation, staffId, loyalty tier, and points inflation blocked.
    // -------------------------------------------------------------
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) && isValidUser(request.resource.data, userId)) || isAdmin();
      allow update: if (isOwner(userId) && isValidUser(request.resource.data, userId)) || isAdmin();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 7. Orders (/orders/{orderId})
    // Creation: ZERO DIRECT CLIENT CREATION (Requirement 2).
    // All orders, including guest orders, MUST be created through the trusted
    // /api/orders/create backend API to enforce authoritative pricing, 3% GST,
    // inventory reservation, and payment status initialization.
    // Read: Restricted to the authenticated patron owner OR Admin.
    // Update: Strictly restricted to trusted Root Admin / backend update operations.
    // Delete: Disallowed (audit trail protection).
    // -------------------------------------------------------------
    match /orders/{orderId} {
      allow create: if isRootAdmin();
      allow read: if (
        isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          (request.auth.token.email != null && resource.data.customerEmail == request.auth.token.email)
        )
      ) || isAdmin();
      allow update: if isRootAdmin();
      allow delete: if false;
    }

    // -------------------------------------------------------------
    // 8. Bespoke Custom Enquiries (/custom_enquiries/{enquiryId})
    // Patrons & guests can submit custom commission requests.
    // Read/Update/Delete is strictly restricted to Admin/Concierge.
    // -------------------------------------------------------------
    match /custom_enquiries/{enquiryId} {
      allow create: if isValidCustomEnquiry(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 9. Corporate Gifting Enquiries (/corporate_enquiries/{enquiryId})
    // Prospective institutional clients can submit leads.
    // Read/Update/Delete is strictly restricted to Admin.
    // -------------------------------------------------------------
    match /corporate_enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 10. Support Tickets (/support_tickets/{ticketId})
    // Create: Anyone can create a support ticket with valid schema.
    // Read: Ticket creator (by email/userId match) OR Admin.
    // Update: Admin can reply/resolve; Creator can APPEND messages only (Requirement 6).
    // Cannot edit or remove previous messages, alter staff replies, change ownership,
    // or modify ticket status.
    // Delete: Disallowed for clients (Admin only).
    // -------------------------------------------------------------
    match /support_tickets/{ticketId} {
      allow create: if isValidSupportTicket(request.resource.data);
      allow read: if (
        isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          (request.auth.token.email != null && resource.data.email == request.auth.token.email)
        )
      ) || isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        (resource.data.userId == request.auth.uid || resource.data.email == request.auth.token.email) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['messages', 'updatedAt']) &&
        request.resource.data.messages.size() == resource.data.messages.size() + 1 &&
        request.resource.data.messages.hasAll(resource.data.messages) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.messages.size() <= 50
      );
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 11. Security Audit Logs (/audit_logs/{logId})
    // Read restricted to Administrators; writes strictly restricted to Root Super Admin.
    // -------------------------------------------------------------
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isRootAdmin();
    }

    // -------------------------------------------------------------
    // 12. Admin Users ACL (/admin_users/{adminId})
    // Read: Verified Administrators only (customers cannot enumerate staff).
    // Write: Strictly restricted to Root Super Admin (prevents staff privilege escalation).
    // -------------------------------------------------------------
    match /admin_users/{adminId} {
      allow read: if isAdmin();
      allow write: if isRootAdmin();
    }

    // -------------------------------------------------------------
    // 13. System Health Diagnostics (/system/{docId})
    // Restrict public read to operational health beacon only.
    // Writes restricted to Root Super Admin.
    // -------------------------------------------------------------
    match /system/{docId} {
      allow read: if docId == 'health';
      allow write: if isRootAdmin();
    }

    // -------------------------------------------------------------
    // 14. Checkout Idempotency Register (/idempotency_keys/{key})
    // STRICTLY SERVER-ONLY (Requirement 1). Zero client read or write access.
    // Managed exclusively by trusted server operations.
    // -------------------------------------------------------------
    match /idempotency_keys/{key} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // 15. Dynamic Administrative Roles (/admin_roles/{roleId})
    // Read: Verified Administrators only.
    // Write: Strictly restricted to Root Super Admin (ordinary staff cannot alter roles).
    // -------------------------------------------------------------
    match /admin_roles/{roleId} {
      allow read: if isAdmin();
      allow write: if isRootAdmin();
    }

    // -------------------------------------------------------------
    // 16. Staff ID Login Index (/staff_id_index/{staffId})
    // STRICTLY SERVER-ONLY (Requirement 3). Zero public enumeration or client modification.
    // Staff ID mapping operations execute exclusively via secure backend API endpoints.
    // -------------------------------------------------------------
    match /staff_id_index/{staffId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // 17. System Counters (/counters/{counterId})
    // Read: Verified Administrators only.
    // Write: Strictly restricted to Root Super Admin / Server allocation.
    // -------------------------------------------------------------
    match /counters/{counterId} {
      allow read: if isAdmin();
      allow write: if isRootAdmin();
    }

    // -------------------------------------------------------------
    // 18. Staff Usernames Directory (/admin_usernames/{username})
    // STRICTLY SERVER-ONLY (Requirement 3). Zero public enumeration or client modification.
    // Username resolution and availability checks operate exclusively via secure backend API endpoints.
    // -------------------------------------------------------------
    match /admin_usernames/{username} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // 19. Distributed Tracking Rate Limiter (/tracking_ratelimits/{ipHash})
    // Strictly restricted against all direct client reads and writes.
    // Read and modified exclusively by trusted server-side operations.
    // -------------------------------------------------------------
    match /tracking_ratelimits/{ipHash} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // Default Deny
    // -------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

# =========================================================================
# GLOBAL DATA FALLBACK ARCHITECTURE
# =========================================================================
# Controls whether demo/seed data fills gaps when actual Firestore records are absent.
# Set to 'true' in Preproduction (actual data takes priority, dummy fills missing content).
# Set to 'false' in Production (actual data only, clean empty states, zero dummy data).
APP_DEMO_FALLBACK_ENABLED="true"
NEXT_PUBLIC_APP_DEMO_FALLBACK_ENABLED="true"

ORDER_TRACKING_SECRET=""

# Server-Side Firebase Admin (Production/Staging credentials)
# Set either FIREBASE_SERVICE_ACCOUNT_KEY (full JSON) or individual keys:
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""

# =========================================================================
# LOCAL FIREBASE EMULATOR CONFIGURATION (DEVELOPMENT ONLY)
# =========================================================================
# To isolate local testing completely and protect live production data,
# run `firebase emulators:start` and enable the matching flags:
#
# Client Browser Emulators (Only active on localhost in non-production):
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
# NEXT_PUBLIC_USE_AUTH_EMULATOR=false
#
# Server-side Firebase Admin Emulator (Only active in non-production):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8088
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
#
# NOTE: In production (Netlify), emulator variables are strictly ignored by
# code-level guards, and emulators are never contacted.
